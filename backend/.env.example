# Copy this to .env and fill in values
# NEVER commit .env to git

APP_NAME=RepoInsight
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://repoinsight:repoinsight@localhost:5433/repoinsight

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub API
# GitHub token is used for both GitHub REST API and GitHub MCP Server
GITHUB_TOKEN=your_github_personal_access_token_here

# Gemini API (Two projects for dual quota)
GEMINI_API_KEY_PROJECT_A=your_gemini_project_a_key_here
GEMINI_API_KEY_PROJECT_B=your_gemini_project_b_key_here

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Security
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars